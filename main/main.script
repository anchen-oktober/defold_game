local total_targets = 6
local max_clicks = 10

local target_width = 128
local target_height = 128

local destroyed_targets = 0

function init(self)
	msg.post("camera", "acquire_camera_focus")
	msg.post(".", "acquire_input_focus")
	msg.post("cup#sprite", "disable")
	msg.post("loss#label", "disable")

	self.clicks = 0
	self.destroyed = {}

	print("=== INIT ===")
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then
		self.clicks = self.clicks + 1

		print("\n=== CLICK #" .. self.clicks .. " ===")
		print("action.x / y       :", action.x, action.y)
		print("action.screen_x / y:", action.screen_x, action.screen_y)

		for i = 1, total_targets do
			local target_id = "target" .. i

			if not self.destroyed[target_id] then
				local pos = go.get_world_position(target_id)
				local screen_pos = camera.world_to_screen(pos)

				local dx = math.abs(action.screen_x - screen_pos.x)
				local dy = math.abs(action.screen_y - screen_pos.y)

				print("Target:", target_id)
				print("  World pos :", pos.x, pos.y, pos.z)
				print("  Screen pos:", screen_pos.x, screen_pos.y)
				print("  Delta     :", dx, dy)
				print("  Limit     :", target_width / 2, target_height / 2)

				if dx <= target_width / 2 and dy <= target_height / 2 then

					msg.post(target_id .. "#sprite", "disable")
					self.destroyed[target_id] = true
					destroyed_targets = destroyed_targets + 1

					if destroyed_targets == total_targets then
						show_cup()
					end

					break
				else
					print("❌ MISS:", target_id)
				end
			end
		end

		if self.clicks >= max_clicks and destroyed_targets < total_targets then
			show_loss()
		end
	end
end

function show_cup()
	msg.post("cup#sprite", "enable")
end

function show_loss()
	msg.post("loss#label", "enable")
end